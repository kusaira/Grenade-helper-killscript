/* ============================================================================
   GRENADE HELPER - CYBERPUNK TACTICAL HUD & WORLD ESP STYLES
   ============================================================================ */

.gh-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

/* WORLD ESP TAG CARD */
.gh-world-tag {
    position: absolute;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 12, 20, 0.92);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.5);
    border-radius: 6px;
    padding-left: 8px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    translate: -50% -50%;
}

.gh-tag-type {
    font-size: 10px;
    font-weight: bold;
    font-family: monospace;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 3px;
    margin-right: 8px;
    -unity-text-align: middle-center;
}

/* DYNAMIC GRENADE TYPE COLOR ACCENTS */
.gh-type-frag {
    background-color: rgba(255, 69, 58, 0.25);
    border-width: 1px;
    border-color: #FF453A;
    color: #FF6961;
}

.gh-type-shield {
    background-color: rgba(0, 229, 255, 0.25);
    border-width: 1px;
    border-color: #00E5FF;
    color: #70F3FF;
}

.gh-type-incendiary {
    background-color: rgba(255, 159, 10, 0.25);
    border-width: 1px;
    border-color: #FF9F0A;
    color: #FFC04D;
}

.gh-type-sonar {
    background-color: rgba(191, 90, 242, 0.25);
    border-width: 1px;
    border-color: #BF5AF2;
    color: #DA8FFF;
}

.gh-type-emp {
    background-color: rgba(10, 132, 255, 0.25);
    border-width: 1px;
    border-color: #0A84FF;
    color: #64D2FF;
}

.gh-type-default {
    background-color: rgba(0, 255, 157, 0.25);
    border-width: 1px;
    border-color: #00FF9D;
    color: #00FF9D;
}

.gh-tag-title {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: bold;
    font-family: monospace;
    -unity-text-align: middle-center;
}

.gh-tag-sub {
    color: #00E5FF;
    font-size: 11px;
    font-weight: bold;
    margin-left: 8px;
    font-family: monospace;
    -unity-text-align: middle-center;
}

.gh-tag-sub.is-aligning {
    color: #00FF9D;
}

/* AIM MARKER RETICLE */
.gh-aim-marker {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: 2px;
    translate: -50% -50%;
    align-items: center;
    justify-content: center;
}

.gh-aim-marker-unaligned {
    border-color: #FF9F0A;
    background-color: rgba(10, 14, 22, 0.7);
}

.gh-aim-marker-aligned {
    border-color: #00FF9D;
    background-color: rgba(0, 255, 157, 0.25);
}

.gh-aim-dot-inner {
    width: 6px;
    height: 6px;
    border-radius: 3px;
}

.gh-aim-dot-unaligned {
    background-color: #FF9F0A;
}

.gh-aim-dot-aligned {
    background-color: #00FF9D;
}

/* AIM MARKER TEXT LABEL IN SKY */
.gh-aim-label {
    position: absolute;
    top: 24px;
    left: 50%;
    translate: -50% 0;
    white-space: nowrap;
    background-color: rgba(8, 12, 20, 0.92);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.6);
    border-radius: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: bold;
    font-family: monospace;
    -unity-text-align: middle-center;
}

.gh-aim-marker-aligned .gh-aim-label {
    border-color: #00FF9D;
    color: #00FF9D;
}

/* RECORDING NOTIFICATION BANNER */
.gh-rec-banner {
    position: absolute;
    top: 35px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 6, 10, 0.92);
    border-width: 1px;
    border-color: #FF3B30;
    border-radius: 6px;
    padding-left: 14px;
    padding-right: 16px;
    padding-top: 7px;
    padding-bottom: 7px;
}

.gh-rec-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #FF3B30;
    margin-right: 10px;
}

.gh-rec-text {
    color: #FF6961;
    font-size: 13px;
    font-weight: bold;
    font-family: monospace;
    -unity-text-align: middle-center;
}

.gh-hidden {
    display: none;
}
