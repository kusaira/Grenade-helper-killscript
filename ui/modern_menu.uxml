<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="./modern_menu.uss" />
    <ui:VisualElement name="ModernMenuOverlay" class="aio2-overlay">
        <ui:VisualElement name="ModernMenuPanel" class="aio2-panel">
            
            <!-- TACTICAL TITLE BAR -->
            <ui:VisualElement class="aio2-topbar">
                <ui:VisualElement class="aio2-top-pill">
                    <ui:Label text="GRENADE HELPER PRO // v2.0" class="aio2-top-pill-text" />
                </ui:VisualElement>
                <ui:VisualElement name="veM2DragHandle" class="aio2-topbar-spacer" />
                <ui:VisualElement class="aio2-config-group">
                    <ui:Label text="CONFIG:" class="aio2-config-label" />
                    <ui:Button name="btnM2ExportJson" text="EXPORT" class="aio2-reset aio2-config-btn" />
                    <ui:Button name="btnM2ImportJson" text="OVERWRITE" class="aio2-reset aio2-config-btn" />
                    <ui:Button name="btnM2AddJson" text="APPEND" class="aio2-reset aio2-config-btn" />
                </ui:VisualElement>
                <ui:Button name="btnM2Close" text="X" class="aio2-close" />
            </ui:VisualElement>

            <!-- MAIN BODY -->
            <ui:VisualElement class="aio2-main">

                <ui:VisualElement class="aio2-content">
                    
                    <!-- LINEUPS DIRECTORY -->
                    <ui:VisualElement name="pageM2Lineups" class="aio2-page">
                        
                        <!-- SEARCH BAR AND CATEGORY FILTERS BAR -->
                        <ui:VisualElement class="cmd-filter-bar">
                            <!-- SEARCH FIELD -->
                            <ui:VisualElement class="cmd-search-box">
                                <ui:Label text="SEARCH:" class="cmd-search-label" />
                                <ui:TextField name="txtM2SearchInput" class="cmd-text-field" />
                            </ui:VisualElement>

                            <!-- TYPE FILTER CHIPS -->
                            <ui:VisualElement class="cmd-filter-chips">
                                <ui:Button name="btnM2FilterAll" text="ALL" class="cmd-preset-btn" />
                                <ui:Button name="btnM2FilterSonar" text="SONAR" class="cmd-preset-btn" />
                                <ui:Button name="btnM2FilterEmp" text="EMP" class="cmd-preset-btn" />
                                <ui:Button name="btnM2FilterFrag" text="FRAG" class="cmd-preset-btn" />
                                <ui:Button name="btnM2FilterFire" text="FIRE" class="cmd-preset-btn" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:ScrollView name="veM2LineupList" class="aio2-card cmd-scrollview" mode="Vertical">
                            <ui:Label name="lblM2EmptyLineups" text="No saved target spots matching search filter." class="aio2-row-label cmd-empty-label" />
                        </ui:ScrollView>

                        <!-- PAGINATION CONTROLS FOOTER -->
                        <ui:VisualElement name="veM2PaginationBar" class="cmd-pagination-bar">
                            <ui:Label name="lblM2CurrentMapCaption" text="INDEX OF SAVED GRENADE TARGETS" class="cmd-lineup-detail cmd-caption-text" />
                            <ui:VisualElement class="cmd-pagination-controls">
                                <ui:Button name="btnM2PrevPage" text="&lt;&lt; PREV" class="cmd-page-btn cmd-page-btn-prev" />
                                <ui:Label name="lblM2PageIndicator" text="PAGE 1 / 1" class="cmd-page-indicator" />
                                <ui:Button name="btnM2NextPage" text="NEXT &gt;&gt;" class="cmd-page-btn" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- RENAME DIALOG MODAL -->
            <ui:VisualElement name="veM2RenameModal" class="cmd-modal-container">
                <ui:VisualElement class="cmd-modal-box">
                    <ui:Label text="RENAME LINEUP TARGET" class="cmd-modal-title" />
                    <ui:Label text="Enter new custom callout name for this lineup spot:" class="cmd-modal-subtext" />
                    <ui:TextField name="txtM2RenameInput" class="cmd-text-field" />
                    
                    <!-- PRESET QUICK BUTTONS -->
                    <ui:VisualElement class="cmd-preset-bar">
                        <ui:Button name="btnM2PresetHeaven" text="Heaven" class="cmd-preset-btn" />
                        <ui:Button name="btnM2PresetAMain" text="A Main" class="cmd-preset-btn" />
                        <ui:Button name="btnM2PresetBSite" text="B Site" class="cmd-preset-btn" />
                        <ui:Button name="btnM2PresetMid" text="Mid" class="cmd-preset-btn" />
                        <ui:Button name="btnM2PresetWindow" text="Window" class="cmd-preset-btn" />
                    </ui:VisualElement>

                    <ui:VisualElement class="cmd-modal-actions">
                        <ui:Button name="btnM2RenameSave" text="CONFIRM" class="aio2-reset" />
                        <ui:Button name="btnM2RenameCancel" text="CANCEL" class="aio2-close cmd-cancel-btn" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
