<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="./modern_menu.uss" />
    <ui:VisualElement name="ModernMenuOverlay" class="aio2-overlay">
        <ui:VisualElement name="ModernMenuPanel" class="aio2-panel">
            
            <!-- TACTICAL TITLE BAR -->
            <ui:VisualElement class="aio2-topbar">
                <ui:VisualElement class="aio2-top-pill">
                    <ui:Label text="GRENADE HELPER PRO // v2.0" class="aio2-top-pill-text" />
                </ui:VisualElement>
                <ui:VisualElement name="veM2DragHandle" class="aio2-topbar-spacer" />
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-right: 10px;">
                    <ui:Label text="CONFIG:" style="color: #00E5FF; font-size: 11px; font-weight: bold; margin-right: 8px;" />
                    <ui:Button name="btnM2ExportJson" text="EXPORT" class="aio2-reset" style="margin-right: 6px; padding-left: 10px; padding-right: 10px;" />
                    <ui:Button name="btnM2ImportJson" text="OVERWRITE" class="aio2-reset" style="margin-right: 6px; padding-left: 10px; padding-right: 10px;" />
                    <ui:Button name="btnM2AddJson" text="APPEND" class="aio2-reset" style="margin-right: 6px; padding-left: 10px; padding-right: 10px;" />
                </ui:VisualElement>
                <ui:Button name="btnM2Close" text="X" class="aio2-close" />
            </ui:VisualElement>

            <!-- MAIN BODY -->
            <ui:VisualElement class="aio2-main">
                <ui:VisualElement class="cmd-prompt-line">
                    <ui:Label text="SYSTEM ::" class="cmd-path" />
                    <ui:Label text=" ACTIVE CONTROL PANEL" class="cmd-command" />
                </ui:VisualElement>

                <ui:Label text="KillScript Sandbox Tactical Grenade Assistant module by @Keqqyrr" class="cmd-banner" />

                <ui:VisualElement class="aio2-content">
                    
                    <!-- LINEUPS DIRECTORY -->
                    <ui:VisualElement name="pageM2Lineups" class="aio2-page">
                        
                        <!-- SEARCH BAR AND CATEGORY FILTERS BAR -->
                        <ui:VisualElement class="cmd-filter-bar" style="flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                            <!-- SEARCH FIELD -->
                            <ui:VisualElement style="flex-direction: row; align-items: center; flex-grow: 1; margin-right: 12px;">
                                <ui:Label text="SEARCH:" class="cmd-lineup-title" style="margin-right: 6px; font-size: 11px; color: #00E5FF;" />
                                <ui:TextField name="txtM2SearchInput" class="cmd-text-field" style="margin-bottom: 0px; flex-grow: 1; font-size: 11px; padding: 4px;" />
                            </ui:VisualElement>

                            <!-- TYPE FILTER CHIPS -->
                            <ui:VisualElement style="flex-direction: row; align-items: center;">
                                <ui:Button name="btnM2FilterAll" text="ALL" class="cmd-preset-btn" />
                                <ui:Button name="btnM2FilterSonar" text="SONAR" class="cmd-preset-btn" />
                                <ui:Button name="btnM2FilterEmp" text="EMP" class="cmd-preset-btn" />
                                <ui:Button name="btnM2FilterFrag" text="FRAG" class="cmd-preset-btn" />
                                <ui:Button name="btnM2FilterFire" text="FIRE" class="cmd-preset-btn" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:ScrollView name="veM2LineupList" class="aio2-card cmd-scrollview" mode="Vertical">
                            <ui:Label name="lblM2EmptyLineups" text="No saved target spots matching search filter." class="aio2-row-label" style="color: #7E8E9F; margin: 20px; text-align: center;" />
                        </ui:ScrollView>

                        <!-- PAGINATION CONTROLS FOOTER -->
                        <ui:VisualElement name="veM2PaginationBar" style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: 8px; padding-left: 4px; padding-right: 4px;">
                            <ui:Label name="lblM2CurrentMapCaption" text="INDEX OF SAVED GRENADE TARGETS" class="cmd-lineup-detail" style="color: #7E8E9F; font-size: 10px;" />
                            <ui:VisualElement style="flex-direction: row; align-items: center;">
                                <ui:Button name="btnM2PrevPage" text="&lt;&lt; PREV" class="cmd-preset-btn" style="padding-left: 8px; padding-right: 8px;" />
                                <ui:Label name="lblM2PageIndicator" text="PAGE 1 / 1" class="cmd-lineup-title" style="font-size: 11px; color: #00E5FF; margin-left: 6px; margin-right: 6px;" />
                                <ui:Button name="btnM2NextPage" text="NEXT &gt;&gt;" class="cmd-preset-btn" style="padding-left: 8px; padding-right: 8px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- RENAME DIALOG MODAL -->
            <ui:VisualElement name="veM2RenameModal" class="cmd-modal-container" style="display: none;">
                <ui:VisualElement class="cmd-modal-box">
                    <ui:Label text="RENAME LINEUP TARGET" class="cmd-modal-title" />
                    <ui:Label text="Enter new custom callout name for this lineup spot:" class="cmd-lineup-detail" style="margin-bottom: 10px;" />
                    <ui:TextField name="txtM2RenameInput" class="cmd-text-field" />
                    
                    <!-- PRESET QUICK BUTTONS -->
                    <ui:VisualElement class="cmd-preset-bar">
                        <ui:Button name="btnM2PresetHeaven" text="Heaven" class="cmd-preset-btn" />
                        <ui:Button name="btnM2PresetAMain" text="A Main" class="cmd-preset-btn" />
                        <ui:Button name="btnM2PresetBSite" text="B Site" class="cmd-preset-btn" />
                        <ui:Button name="btnM2PresetMid" text="Mid" class="cmd-preset-btn" />
                        <ui:Button name="btnM2PresetWindow" text="Window" class="cmd-preset-btn" />
                    </ui:VisualElement>

                    <ui:VisualElement class="cmd-modal-actions">
                        <ui:Button name="btnM2RenameSave" text="CONFIRM" class="aio2-reset" />
                        <ui:Button name="btnM2RenameCancel" text="CANCEL" class="aio2-close" style="width: auto; padding-left: 14px; padding-right: 14px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
